{
 "openapi": "3.1.0",
 "info": {
  "title": "Resolve JSON API",
  "version": "2",
  "description": "Contract for the mobile app and any UI. Mobile needs the 'mobile' tag: POST /chat, GET /api/chat/{session_id} (poll for support replies after a handoff), GET /api/users, POST /feedback. Default dev server: http://<laptop-LAN-IP>:8010."
 },
 "paths": {
  "/chat": {
   "post": {
    "tags": [
     "mobile"
    ],
    "summary": "Send one user message to the Level 2 agent",
    "operationId": "chat_chat_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ChatRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ChatResult"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/chat/{session_id}": {
   "get": {
    "tags": [
     "mobile"
    ],
    "summary": "Conversation, tool-call log and outcome (404 if unknown)",
    "operationId": "chat_history_api_chat__session_id__get",
    "parameters": [
     {
      "name": "session_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Session Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ChatSession"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/feedback": {
   "post": {
    "tags": [
     "mobile"
    ],
    "summary": "Feedback outside the chat; triage runs in the background",
    "operationId": "feedback_feedback_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/FeedbackRequest"
       }
