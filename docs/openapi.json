     },
     "closed_by_people": {
      "type": "integer",
      "title": "Closed By People",
      "description": "Tickets a person closed in Level 1"
     },
     "feedback": {
      "type": "integer",
      "title": "Feedback",
      "description": "Other feedback that came in (form, email)"
     },
     "grant_days": {
      "type": "integer",
      "title": "Grant Days"
     }
