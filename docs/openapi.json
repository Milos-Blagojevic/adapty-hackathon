   },
   "TriageOption": {
    "properties": {
     "action": {
      "type": "string",
      "enum": [
       "grant_access",
       "reply_only",
       "store_instructions",
       "refund_to_human",
       "ask_user",
       "no_reply"
      ],
      "title": "Action"
     },
     "params": {
      "$ref": "#/components/schemas/OptionParams"
     },
