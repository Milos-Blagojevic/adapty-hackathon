     "confidence_buckets",
     "accepted_option",
     "top_root_causes"
    ],
    "title": "TriageStats"
   },
   "TriageView": {
    "properties": {
     "customer_user_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Customer User Id",
      "description": "The Adapty customer user id, or null when not found"
     },
     "lookup": {
      "type": "string",
      "title": "Lookup",
      "description": "How the user was identified or why not (e.g. 'id from chat', 'email not in index')"
     },
     "summary": {
      "type": "string",
      "title": "Summary",
      "description": "One sentence: what the user wants"
     },
     "category": {
      "type": "string",
      "enum": [
       "charged_after_trial",
       "no_access_after_purchase",
       "billing_issue",
       "refund_request",
       "cancel_how",
       "price_complaint",
       "other"
      ],
      "title": "Category"
     },
     "evidence": {
      "items": {
       "type": "string"
      },
      "type": "array",
